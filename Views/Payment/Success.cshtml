@model Bizbox.Models.Order
@{
    ViewData["Title"] = "Payment Successful";
}
<div class="page-header">
    <span class="eyebrow">Order confirmed</span>
    <h1>Payment Successful</h1>
</div>

@if (Model != null)
{
    <div class="card" style="max-width: 480px;">
        <div class="card-body">
            <p><strong>Order #@Model.Id</strong> &middot; Rs. @Model.TotalAmount &middot; <span class="badge badge-new">@Model.Status</span></p>
            <ul style="padding-left: 1.2em;">
                @foreach (var item in Model.Items)
                {
                    <li>@item.Product?.Name &times; @item.Quantity &mdash; Rs. @item.UnitPriceAtPurchase each</li>
                }
            </ul>
        </div>
    </div>
}
<p style="margin-top: var(--space-5);"><a class="btn" asp-controller="Home" asp-action="Index">Back to home</a></p>
