@model List<CartItem>
@{
    ViewData["Title"] = "Your Cart";
}

<h1>Your Cart</h1>

@if (!Model.Any())
{
    <p>Your cart is empty.</p>
}
else
{
    <div class="product-grid">
        @foreach (var item in Model)
        {
            <div class="product-card">
                <h3>@item.Product?.Name</h3>
                <p>Qty: @item.Quantity</p>
                <p class="price">Rs. @((item.Product?.Price ?? 0) * item.Quantity)</p>
                <form method="post" asp-action="Remove" asp-controller="Cart">
                    <input type="hidden" name="cartItemId" value="@item.Id" />
                    <button type="submit">Remove</button>
                </form>
            </div>
        }
    </div>

    <h2>Total: Rs. @ViewBag.Total</h2>
    <a class="checkout-link" href="@Url.Action("Index", "Checkout")">Proceed to Checkout</a>
}
