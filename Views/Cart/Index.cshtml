@using Bizbox.Helpers
@model List<CartItem>
@{
    ViewData["Title"] = "Your Cart";
}

<div class="page-header">
    <span class="eyebrow">Cart</span>
    <h1>Your Cart</h1>
</div>

@if (TempData["Message"] != null)
{
    <p class="error-message">@TempData["Message"]</p>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <span class="icon">🛒</span>
        <p>Your cart is empty.</p>
        <a class="btn" asp-controller="Home" asp-action="Index">Browse equipment</a>
    </div>
}
else
{
    <table class="cart-table">
        <thead>
            <tr><th></th><th>Item</th><th>Price</th><th>Qty</th><th>Subtotal</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><div class="cart-thumb">@IconHelper.GetIcon(item.Product?.Name ?? "")</div></td>
                    <td>@item.Product?.Name</td>
                    <td>Rs. @item.Product?.Price.ToString("N0")</td>
                    <td>@item.Quantity</td>
                    <td><strong>Rs. @((item.Product?.Price ?? 0) * item.Quantity)</strong></td>
                    <td>
                        <form method="post" asp-action="Remove" asp-controller="Cart">
                            <input type="hidden" name="cartItemId" value="@item.Id" />
                            <button type="submit" class="btn-secondary btn btn-sm">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="cart-bar">
        <span class="subtotal">Total: Rs. @ViewBag.Total</span>
        <a class="btn" style="min-width:200px;" href="@Url.Action("Index", "Checkout")">Proceed to Checkout</a>
    </div>
}
