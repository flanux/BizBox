@using Bizbox.Helpers
@model List<CartItem>
@{
    ViewData["Title"] = "Your Cart";
}

<div class="page-header">
    <span class="eyebrow">Cart</span>
    <h1>Your Cart</h1>
</div>

@if (TempData["Message"] != null)
{
    <p class="error-message">@TempData["Message"]</p>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <span class="icon">🛒</span>
        <p>Your cart is empty.</p>
        <a class="btn" asp-controller="Home" asp-action="Index">Browse business types</a>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        <div class="cart-row">
            <div class="icon-tile">@IconHelper.GetIcon(item.Product?.Name ?? "")</div>
            <div class="info">
                <strong>@item.Product?.Name</strong>
                <p class="text-muted" style="margin:0;">Qty: @item.Quantity &middot; Rs. @item.Product?.Price.ToString("N0") each</p>
            </div>
            <div>
                <strong>Rs. @((item.Product?.Price ?? 0) * item.Quantity)</strong>
            </div>
            <form method="post" asp-action="Remove" asp-controller="Cart">
                <input type="hidden" name="cartItemId" value="@item.Id" />
                <button type="submit" class="btn-secondary btn">Remove</button>
            </form>
        </div>
    }

    <div class="cart-summary">
        <div class="cart-total">Total: Rs. @ViewBag.Total</div>
        <a class="btn btn-block" href="@Url.Action("Index", "Checkout")">Proceed to Checkout</a>
    </div>
}
