@using Bizbox.Helpers
@model List<Product>
@{
    ViewData["Title"] = "Notifications";
}

<div class="page-header">
    <span class="eyebrow">Updates</span>
    <h1>Upgrade Notifications</h1>
</div>

@if (!Model.Any())
{
    <div class="empty-state"><span class="icon">🔔</span><p>No upgrade notifications right now.</p></div>
}
else
{
    @foreach (var upgrade in Model)
    {
        var priceDiff = upgrade.Price - (upgrade.Supersedes?.Price ?? 0);
        <div class="notif-row">
            <span class="pill pill-upgrade">New Model</span>
            <div class="desc">
                <strong>@upgrade.Supersedes?.Name &rarr; @upgrade.Name</strong>
                <span class="text-muted">@(priceDiff >= 0 ? "+" : "")Rs. @priceDiff.ToString("N0") vs. your current model</span>
            </div>
            <a class="btn btn-sm" asp-controller="Resale" asp-action="Index">List your old one</a>
        </div>
    }
}
