@using Bizbox.Helpers
@using Bizbox.Models
@{
    ViewData["Title"] = "Home";
    var businessTypes = (List<BusinessType>)ViewBag.BusinessTypes;
    var searchResults = (List<Product>?)ViewBag.SearchResults;
    string? term = ViewBag.SearchTerm;
    var teaserBundles = (List<ProductBundle>?)ViewBag.TeaserBundles ?? new List<ProductBundle>();

    var smallBiz = businessTypes.Where(bt => bt.Segment == BusinessSegment.SmallBusiness).ToList();
    var bigBiz = businessTypes.Where(bt => bt.Segment == BusinessSegment.BigBusiness).ToList();
    var hobbyist = businessTypes.Where(bt => bt.Segment == BusinessSegment.Hobbyist).ToList();
}

<section class="hero">
    <h1>Pick your path. Get equipped.</h1>
    <p class="subtitle">Starting a small business, running a bigger operation, or just chasing a hobby seriously — curated equipment for all three, or search for something specific.</p>

    <form method="get" asp-action="Index" asp-controller="Home" class="filter-bar" style="margin-top: var(--space-4);">
        <input type="text" name="q" value="@term" placeholder="Search equipment..." />
        <button type="submit" class="btn btn-sm">Search</button>
        @if (!string.IsNullOrWhiteSpace(term))
        {
            <a class="chip" href="@Url.Action("Index", "Home")">Clear</a>
        }
    </form>
</section>

@if (searchResults != null)
{
    <div class="page-header">
        <h2>Results for "@term"</h2>
    </div>
    @if (!searchResults.Any())
    {
        <div class="empty-state"><span class="icon">🔍</span><p>No equipment matches your search.</p></div>
    }
    else
    {
        @foreach (var product in searchResults)
        {
            var (pillClass, pillLabel) = IconHelper.GetStatusPill(product);
            <div class="hcard">
                <a class="hcard-media" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" style="text-decoration:none;">
                    <span class="pill @pillClass">@pillLabel</span>
                    @if (!string.IsNullOrWhiteSpace(product.ImagePath)) { <img src="@product.ImagePath" alt="@product.Name" style="width:100%;height:100%;object-fit:cover;" /> } else { @IconHelper.GetIcon(product.Name) }
                </a>
                <div class="hcard-body">
                    <div class="hcard-manufacturer">@product.Manufacturer</div>
                    <a class="hcard-title" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" style="color:inherit;text-decoration:none;">@product.Name</a>
                    <p class="hcard-desc">@product.Description</p>
                    <div class="hcard-bottom">
                        <span class="hcard-price">Rs. @product.Price.ToString("N0")</span>
                        <a class="btn btn-sm" asp-controller="BusinessType" asp-action="Catalog" asp-route-id="@product.BusinessTypeId">View in catalog</a>
                    </div>
                </div>
            </div>
        }
    }
}
else
{
    @* ---- One-tap category strip: every category, horizontally scrollable ---- *@
    <div class="category-strip">
        @foreach (var bt in businessTypes)
        {
            <a class="category-chip" asp-controller="BusinessType" asp-action="Catalog" asp-route-id="@bt.Id">
                <span>@IconHelper.GetBusinessIcon(bt)</span>@bt.Name
            </a>
        }
    </div>

    @* ---- Segment tabs (pure CSS, no JS) + a grid per segment ---- *@
    <div class="segment-tabs">
        <input type="radio" name="segment" id="seg-small" class="segment-tab-input" checked />
        <input type="radio" name="segment" id="seg-big" class="segment-tab-input" />
        <input type="radio" name="segment" id="seg-hobby" class="segment-tab-input" />

        <div class="segment-tab-strip">
            <label for="seg-small" class="segment-tab-label">Small Business</label>
            <label for="seg-big" class="segment-tab-label">Big Business</label>
            <label for="seg-hobby" class="segment-tab-label">Hobbyist</label>
        </div>

        <div class="segment-panel" data-panel="small">
            <p class="text-muted">Solo or small-team operations — a shop, a stall, a home-based business.</p>
            <div class="category-grid">
                @foreach (var bt in smallBiz)
                {
                    <a class="category-card" asp-controller="BusinessType" asp-action="Catalog" asp-route-id="@bt.Id">
                        <span class="category-card-icon">@IconHelper.GetBusinessIcon(bt)</span>
                        <span class="category-card-name">@bt.Name</span>
                        <span class="category-card-desc">@bt.ShortDescription</span>
                        <span class="category-card-count">@bt.Products.Count(p => p.IsActive) item@(bt.Products.Count(p => p.IsActive) == 1 ? "" : "s")</span>
                    </a>
                }
            </div>
        </div>

        <div class="segment-panel" data-panel="big">
            <p class="text-muted">A bigger operation with a team behind it — more volume, more equipment.</p>
            <div class="category-grid">
                @foreach (var bt in bigBiz)
                {
                    <a class="category-card" asp-controller="BusinessType" asp-action="Catalog" asp-route-id="@bt.Id">
                        <span class="category-card-icon">@IconHelper.GetBusinessIcon(bt)</span>
                        <span class="category-card-name">@bt.Name</span>
                        <span class="category-card-desc">@bt.ShortDescription</span>
                        <span class="category-card-count">@bt.Products.Count(p => p.IsActive) item@(bt.Products.Count(p => p.IsActive) == 1 ? "" : "s")</span>
                    </a>
                }
            </div>
        </div>

        <div class="segment-panel" data-panel="hobby">
            <p class="text-muted">Not a business at all — just kitting out a hobby properly.</p>
            <div class="category-grid">
                @foreach (var bt in hobbyist)
                {
                    <a class="category-card" asp-controller="BusinessType" asp-action="Catalog" asp-route-id="@bt.Id">
                        <span class="category-card-icon">@IconHelper.GetBusinessIcon(bt)</span>
                        <span class="category-card-name">@bt.Name</span>
                        <span class="category-card-desc">@bt.ShortDescription</span>
                        <span class="category-card-count">@bt.Products.Count(p => p.IsActive) item@(bt.Products.Count(p => p.IsActive) == 1 ? "" : "s")</span>
                    </a>
                }
            </div>
        </div>
    </div>

    @if (teaserBundles.Any())
    {
        <div class="page-header" style="margin-top: var(--space-6);">
            <span class="eyebrow">Popular</span>
            <h2>Bundles worth a look</h2>
        </div>

        <div class="bundle-row">
            @foreach (var bundle in teaserBundles)
            {
                var bundleTotal = bundle.Items.Sum(i => (i.Product?.Price ?? 0) * i.Quantity);
                <a class="bundle-row-card" asp-controller="BusinessType" asp-action="Catalog" asp-route-id="@bundle.BusinessTypeId">
                    <div class="bundle-row-media">
                        @if (!string.IsNullOrWhiteSpace(bundle.ImagePath))
                        {
                            <img src="@bundle.ImagePath" alt="@bundle.Name" style="width:100%;height:100%;object-fit:cover;" />
                        }
                        else
                        {
                            @IconHelper.GetBusinessIcon(bundle.BusinessType!)
                        }
                    </div>
                    <div class="bundle-row-name">@bundle.Name</div>
                    <div class="bundle-row-price">Rs. @bundleTotal.ToString("N0")</div>
                </a>
            }
        </div>
    }
}
