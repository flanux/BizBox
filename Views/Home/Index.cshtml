@using Bizbox.Helpers
@using Bizbox.Models
@{
    ViewData["Title"] = "Home";
    var businessTypes = (List<BusinessType>)ViewBag.BusinessTypes;
    var byCategory = (Dictionary<int, List<Product>>)ViewBag.ProductsByCategory;
    var searchResults = (List<Product>?)ViewBag.SearchResults;
    string? term = ViewBag.SearchTerm;
}

<section class="hero">
    <h1>Pick your business type. Get equipped.</h1>
    <p class="subtitle">Curated equipment for coffee shops, bakeries, restaurants, and salons — browse below, or search for something specific.</p>

    <form method="get" asp-action="Index" asp-controller="Home" class="filter-bar" style="margin-top: var(--space-4);">
        <input type="text" name="q" value="@term" placeholder="Search equipment..." />
        <button type="submit" class="btn btn-sm">Search</button>
        @if (!string.IsNullOrWhiteSpace(term))
        {
            <a class="chip" href="@Url.Action("Index", "Home")">Clear</a>
        }
    </form>
</section>

@if (searchResults != null)
{
    <div class="page-header">
        <h2>Results for "@term"</h2>
    </div>
    @if (!searchResults.Any())
    {
        <div class="empty-state"><span class="icon">🔍</span><p>No equipment matches your search.</p></div>
    }
    else
    {
        @foreach (var product in searchResults)
        {
            var (pillClass, pillLabel) = IconHelper.GetStatusPill(product);
            <div class="hcard">
                <div class="hcard-media">
                    <span class="pill @pillClass">@pillLabel</span>
                    @if (!string.IsNullOrWhiteSpace(product.ImagePath)) { <img src="@product.ImagePath" alt="@product.Name" style="width:100%;height:100%;object-fit:cover;" /> } else { @IconHelper.GetIcon(product.Name) }
                </div>
                <div class="hcard-body">
                    <div class="hcard-manufacturer">@product.Manufacturer</div>
                    <div class="hcard-title">@product.Name</div>
                    <p class="hcard-desc">@product.Description</p>
                    <div class="hcard-bottom">
                        <span class="hcard-price">Rs. @product.Price.ToString("N0")</span>
                        <a class="btn btn-sm" asp-controller="BusinessType" asp-action="Catalog" asp-route-id="@product.BusinessTypeId">View in catalog</a>
                    </div>
                </div>
            </div>
        }
    }
}
else
{
    @foreach (var bt in businessTypes)
    {
        var products = byCategory.ContainsKey(bt.Id) ? byCategory[bt.Id] : new List<Product>();
        <section class="category-section">
            <div class="category-header">
                <h2><span class="icon">@IconHelper.GetBusinessIcon(bt.Name)</span>@bt.Name</h2>
                <a asp-controller="BusinessType" asp-action="Catalog" asp-route-id="@bt.Id">View all &rarr;</a>
            </div>

            @if (!products.Any())
            {
                <p class="text-muted">No items listed yet.</p>
            }
            else
            {
                <div class="mini-grid">
                    @foreach (var product in products)
                    {
                        <a class="mini-card" asp-controller="BusinessType" asp-action="Catalog" asp-route-id="@bt.Id" style="color:inherit;text-decoration:none;">
                            <div class="mini-card-media">
                                @if (!string.IsNullOrWhiteSpace(product.ImagePath)) { <img src="@product.ImagePath" alt="@product.Name" style="width:100%;height:100%;object-fit:cover;" /> } else { @IconHelper.GetIcon(product.Name) }
                            </div>
                            <div class="mini-card-body">
                                <div class="mini-card-title">@product.Name</div>
                                <div class="mini-card-price">Rs. @product.Price.ToString("N0")</div>
                            </div>
                        </a>
                    }
                </div>
            }
        </section>
    }
}
