<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Bizbox</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" href="/">Bizbox</a>
            <nav class="primary-nav">
                <a asp-controller="Home" asp-action="Index">Browse</a>
                <a asp-controller="Resale" asp-action="Index">Marketplace</a>
            </nav>
            <ul class="nav-account">
                @await Html.PartialAsync("_LoginPartial")
            </ul>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <span>&copy; @DateTime.Now.Year Bizbox</span>
            <span class="links">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Resale" asp-action="Index">Marketplace</a>
                <a asp-controller="Home" asp-action="About">About</a>
            </span>
            <span class="payment-badges">Pay with <span>eSewa</span><span>Khalti</span></span>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
