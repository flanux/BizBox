<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Bizbox</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" href="/">Bizbox</a>
            <nav class="primary-nav">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Resale" asp-action="Index">Marketplace</a>
                <a asp-controller="Home" asp-action="About">About</a>
            </nav>
            <ul class="nav-account">
                @await Html.PartialAsync("_LoginPartial")
            </ul>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-col">
                <h4>Bizbox</h4>
                <p>Curated equipment for starting a small business — coffee shops, bakeries, restaurants, and salons.</p>
            </div>
            <div class="footer-col">
                <h4>Shop</h4>
                <a asp-controller="BusinessType" asp-action="Catalog" asp-route-id="1">Coffee Shop</a>
                <a asp-controller="BusinessType" asp-action="Catalog" asp-route-id="2">Bakery</a>
                <a asp-controller="BusinessType" asp-action="Catalog" asp-route-id="3">Restaurant</a>
                <a asp-controller="BusinessType" asp-action="Catalog" asp-route-id="4">Salon</a>
            </div>
            <div class="footer-col">
                <h4>Company</h4>
                <a asp-controller="Home" asp-action="About">About</a>
                <a asp-controller="Resale" asp-action="Index">Marketplace</a>
            </div>
            <div class="footer-col">
                <h4>Account</h4>
                <a asp-area="Identity" asp-page="/Account/Login">Login</a>
                <a asp-area="Identity" asp-page="/Account/Register">Register</a>
                <a asp-controller="Cart" asp-action="Index">Cart</a>
            </div>
        </div>
        <div class="footer-bottom">&copy; @DateTime.Now.Year Bizbox</div>
    </footer>
</body>
</html>
