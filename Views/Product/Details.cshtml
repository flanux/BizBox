@using Bizbox.Helpers
@model Bizbox.Models.Product
@{
    ViewData["Title"] = Model.Name;
    var (pillClass, pillLabel) = IconHelper.GetStatusPill(Model);
    var specLines = string.IsNullOrWhiteSpace(Model.Specs)
        ? new List<string>()
        : Model.Specs.Split('\u00b7', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
}

<div class="breadcrumb">
    <a asp-controller="Home" asp-action="Index">Home</a>
    <span>/</span>
    <a asp-controller="BusinessType" asp-action="Catalog" asp-route-id="@Model.BusinessTypeId">@Model.BusinessType?.Name</a>
    <span>/</span>
    <span>@Model.Name</span>
</div>

<div class="product-detail">
    <div class="product-detail-media">
        <span class="pill @pillClass">@pillLabel</span>
        @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
        {
            <img src="@Model.ImagePath" alt="@Model.Name" />
        }
        else
        {
            <span class="product-detail-icon">@IconHelper.GetIcon(Model.Name)</span>
        }
    </div>

    <div class="product-detail-info">
        @if (!string.IsNullOrWhiteSpace(Model.Manufacturer))
        {
            <div class="hcard-manufacturer">@Model.Manufacturer</div>
        }
        <h1>@Model.Name</h1>

        @if (Model.SupersedesProductId != null && Model.Supersedes != null)
        {
            <div class="admin-alert">This is a newer model, replacing <strong>@Model.Supersedes.Name</strong>.</div>
        }

        <p class="product-detail-desc">@Model.Description</p>

        @if (specLines.Any())
        {
            <h2>Specifications</h2>
            <ul class="product-detail-specs">
                @foreach (var line in specLines)
                {
                    <li>@line</li>
                }
            </ul>
        }

        <div class="product-detail-buybar">
            <span class="product-detail-price">Rs. @Model.Price.ToString("N0")</span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form method="post" asp-controller="Product" asp-action="AddToCart">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <button type="submit" class="btn">Add to Cart</button>
                </form>
            }
            else
            {
                <a class="btn" asp-area="Identity" asp-page="/Account/Login"
                   asp-route-returnUrl="@Url.Action("Details", "Product", new { id = Model.Id })">
                   Login to buy
                </a>
            }
        </div>
    </div>
</div>
