@{
    ViewData["Title"] = "Checkout";
}

<div class="page-header">
    <span class="eyebrow">Checkout</span>
    <h1>Checkout</h1>
    <p>Order total: <strong>Rs. @ViewBag.Total</strong></p>
</div>

<form method="post" asp-action="PlaceOrder" asp-controller="Checkout" style="max-width: 480px;">
    <fieldset>
        <legend>Choose payment method</legend>

        <label style="font-weight:500;">
            <input type="radio" name="paymentMethod" value="Esewa" checked />
            eSewa
        </label>
        <label style="font-weight:500;">
            <input type="radio" name="paymentMethod" value="Khalti" />
            Khalti
        </label>
        <label style="font-weight:500;">
            <input type="radio" name="paymentMethod" value="InternationalCard_Simulated" />
            International Card
        </label>
    </fieldset>

    <button type="submit" class="btn btn-block">Pay Now</button>
</form>
