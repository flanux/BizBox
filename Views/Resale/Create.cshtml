@{
    ViewData["Title"] = "List an Item";
}
<div class="page-header">
    <span class="eyebrow">Marketplace</span>
    <h1>List a Used Item</h1>
</div>

<form method="post" asp-action="Create" asp-controller="Resale" style="max-width: 480px;">
    <label>Item name<input type="text" name="name" required /></label>
    <label>Description<textarea name="description" rows="3"></textarea></label>
    <label>Price (Rs.)<input type="number" name="price" step="0.01" required /></label>

    <label>Business type
        <select name="businessTypeId">
            @foreach (var bt in (List<BusinessType>)ViewBag.BusinessTypes)
            {
                <option value="@bt.Id">@bt.Name</option>
            }
        </select>
    </label>

    <label>Condition
        <select name="condition">
            <option value="LikeNew">Like New</option>
            <option value="Good">Good</option>
            <option value="Fair">Fair</option>
        </select>
    </label>

    <button type="submit" class="btn btn-block">List Item</button>
</form>
