@using Bizbox.Helpers
@model List<Product>
@{
    ViewData["Title"] = "Marketplace";
}

<div class="page-header">
    <span class="eyebrow">Marketplace</span>
    <h1>Resale &amp; Trade-in Marketplace</h1>
    <p>Equipment listed by other users, at a discount versus buying new.</p>
    <a class="btn" href="@Url.Action("Create")">List an item</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <span class="icon">🏷️</span>
        <p>No resale listings yet.</p>
    </div>
}
else
{
    <div class="grid">
        @foreach (var item in Model)
        {
            <div class="card">
                <div class="icon-tile">@IconHelper.GetIcon(item.Name)</div>
                <div class="card-body">
                    <span class="badge badge-condition">@item.Condition</span>
                    <h3 class="card-title">@item.Name</h3>
                    <p class="card-desc">@item.Description</p>
                    <p class="card-meta">@item.BusinessType?.Name</p>
                    <p class="card-price">Rs. @item.Price.ToString("N0")</p>
                </div>
            </div>
        }
    </div>
}
