@model Bizbox.ViewModels.AdminProductFormViewModel
@{
    var isEdit = Model.Id != 0;
}

<form method="post" enctype="multipart/form-data" asp-controller="Admin" asp-action="@(isEdit ? "Edit" : "Create")" class="admin-form">
    @Html.AntiForgeryToken()
    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
    }

    <div asp-validation-summary="ModelOnly" class="error-message"></div>

    <div class="admin-form-grid">
        <section class="admin-form-card">
            <div class="admin-form-card-header">
                <span class="eyebrow">Identity</span>
                <h2>Product details</h2>
            </div>

            <label asp-for="Name">Name
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="field-error"></span>
            </label>

            <label asp-for="Manufacturer">Manufacturer
                <input asp-for="Manufacturer" />
                <span asp-validation-for="Manufacturer" class="field-error"></span>
            </label>

            <label asp-for="Description">Description
                <textarea asp-for="Description" rows="5"></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </label>

            <label asp-for="Specs">Specifications <span class="text-muted">(use · between specs)</span>
                <textarea asp-for="Specs" rows="4" placeholder="230V · 2000W · 3.5L boiler"></textarea>
                <span asp-validation-for="Specs" class="field-error"></span>
            </label>
        </section>

        <section class="admin-form-card">
            <div class="admin-form-card-header">
                <span class="eyebrow">Commercial</span>
                <h2>Catalog settings</h2>
            </div>

            <label asp-for="Price">Price (Rs.)
                <input asp-for="Price" type="number" step="0.01" min="0" />
                <span asp-validation-for="Price" class="field-error"></span>
            </label>

            <label asp-for="BusinessTypeId">Business type
                <select asp-for="BusinessTypeId">
                    <option value="">-- choose --</option>
                    @foreach (var bt in Model.BusinessTypes)
                    {
                        <option value="@bt.Id">@bt.Name</option>
                    }
                </select>
                <span asp-validation-for="BusinessTypeId" class="field-error"></span>
            </label>

            <label asp-for="SupersedesProductId">Supersedes
                <select asp-for="SupersedesProductId">
                    <option value="">-- none --</option>
                    @foreach (var p in Model.ExistingProducts)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </label>

            <label class="admin-checkbox">
                <input asp-for="IsActive" />
                <span>Visible in the public catalog</span>
            </label>
        </section>
    </div>

    <section class="admin-form-card admin-media-card">
        <div>
            <span class="eyebrow">Media</span>
            <h2>Product image</h2>
            <p class="text-muted">JPG, JPEG, PNG, or WEBP. Maximum 5 MB.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ExistingImagePath))
        {
            <div class="admin-current-image">
                <img src="@Model.ExistingImagePath" alt="Current product image" />
                <span>Current image</span>
            </div>
        }

        <label asp-for="Image">Upload image
            <input asp-for="Image" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
            <span asp-validation-for="Image" class="field-error"></span>
        </label>
    </section>

    <div class="admin-form-actions">
        <a class="btn btn-secondary" asp-controller="Admin" asp-action="Products">Cancel</a>
        <button type="submit" class="btn">@(isEdit ? "Save Changes" : "Create Product")</button>
    </div>
</form>

