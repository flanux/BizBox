@model Bizbox.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-shell">
    <partial name="_Sidebar" />

    <section class="admin-main">
        <div class="page-header admin-page-header">
            <span class="eyebrow">Super Admin</span>
            <div class="admin-header-row">
                <div>
                    <h1>Control Center</h1>
                    <p>Manage the full catalog, categories, orders, and accounts from one place.</p>
                </div>
                <a class="btn" asp-controller="Admin" asp-action="Create">+ Add Product</a>
            </div>
        </div>

        @if (TempData["AdminMessage"] is string message)
        {
            <div class="admin-alert">@message</div>
        }

        <div class="admin-stat-grid">
            <a class="admin-stat" asp-controller="Admin" asp-action="Products" style="text-decoration:none;color:inherit;">
                <span>Platform Products</span><strong>@Model.ProductCount</strong><small>@Model.ActiveProductCount active</small>
            </a>
            <a class="admin-stat" asp-controller="Admin" asp-action="BusinessTypes" style="text-decoration:none;color:inherit;">
                <span>Categories</span><strong>@Model.BusinessTypeCount</strong><small>Business types</small>
            </a>
            <a class="admin-stat" asp-controller="Admin" asp-action="Users" style="text-decoration:none;color:inherit;">
                <span>Users</span><strong>@Model.UserCount</strong><small>Registered accounts</small>
            </a>
            <a class="admin-stat" asp-controller="Admin" asp-action="Orders" style="text-decoration:none;color:inherit;">
                <span>Orders</span><strong>@Model.OrderCount</strong><small>Rs. @Model.OrderValue.ToString("N0") total</small>
            </a>
        </div>

        <div class="admin-section" id="system">
            <div class="admin-section-header">
                <div>
                    <span class="eyebrow">Catalog</span>
                    <h2>Recent products</h2>
                </div>
                <a class="btn btn-secondary btn-sm" asp-controller="Admin" asp-action="Products">Manage all</a>
            </div>

            @if (!Model.RecentProducts.Any())
            {
                <div class="empty-state"><span class="icon">📦</span><p>No products yet. Add your first product to get started.</p></div>
            }
            else
            {
                <div class="admin-product-list">
                    @foreach (var product in Model.RecentProducts)
                    {
                        <div class="admin-product-row">
                            <div class="admin-product-thumb">
                                @if (!string.IsNullOrWhiteSpace(product.ImagePath))
                                {
                                    <img src="@product.ImagePath" alt="@product.Name" />
                                }
                                else
                                {
                                    <span>IMG</span>
                                }
                            </div>
                            <div class="admin-product-info">
                                <strong>@product.Name</strong>
                                <span>@product.Manufacturer · @product.BusinessType?.Name</span>
                            </div>
                            <div class="admin-product-price">Rs. @product.Price.ToString("N0")</div>
                            <span class="pill @(product.IsActive ? "pill-new" : "pill-fair")">@(product.IsActive ? "Active" : "Inactive")</span>
                            <a class="btn btn-secondary btn-sm" asp-controller="Admin" asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</div>
