@model List<Product>
@{
    ViewData["Title"] = "Admin";
}
<div class="page-header">
    <span class="eyebrow">Admin</span>
    <h1>Manage Products</h1>
    <a class="btn" href="@Url.Action("Create")">Add new product</a>
</div>

<table>
    <thead>
        <tr><th>Name</th><th>Business Type</th><th>Price</th><th>Active</th><th>Supersedes</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.BusinessType?.Name</td>
                <td>Rs. @p.Price.ToString("N0")</td>
                <td><span class="badge @(p.IsActive ? "badge-new" : "badge-condition")">@(p.IsActive ? "Active" : "Inactive")</span></td>
                <td>@(p.SupersedesProductId != null ? "Yes" : "\u2014")</td>
                <td>
                    <form method="post" asp-action="ToggleActive" asp-controller="Admin">
                        <input type="hidden" name="id" value="@p.Id" />
                        <button type="submit" class="btn-secondary btn">Toggle</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
