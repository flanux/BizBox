@model Bizbox.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-shell">
    <aside class="admin-sidebar">
        <div class="admin-sidebar-title">Control Center</div>
        <a class="admin-nav-link active" asp-action="Index">Dashboard</a>
        <a class="admin-nav-link" asp-action="Products">Products</a>
        <a class="admin-nav-link" asp-action="Create">Add Product</a>
        <a class="admin-nav-link" href="#system">System</a>
    </aside>

    <section class="admin-main">
        <div class="page-header admin-page-header">
            <span class="eyebrow">Super Admin</span>
            <div class="admin-header-row">
                <div>
                    <h1>Control Center</h1>
                    <p>Manage the platform catalog and inspect the application's core data.</p>
                </div>
                <a class="btn" asp-action="Create">+ Add Product</a>
            </div>
        </div>

        @if (TempData["AdminMessage"] is string message)
        {
            <div class="admin-alert">@message</div>
        }

        <div class="admin-stat-grid">
            <div class="admin-stat"><span>Platform Products</span><strong>@Model.ProductCount</strong><small>@Model.ActiveProductCount active</small></div>
            <div class="admin-stat"><span>Business Types</span><strong>@Model.BusinessTypeCount</strong><small>Catalog categories</small></div>
            <div class="admin-stat"><span>Users</span><strong>@Model.UserCount</strong><small>Identity accounts</small></div>
            <div class="admin-stat"><span>Orders</span><strong>@Model.OrderCount</strong><small>Rs. @Model.OrderValue.ToString("N0") total</small></div>
        </div>

        <div class="admin-section" id="system">
            <div class="admin-section-header">
                <div>
                    <span class="eyebrow">Catalog</span>
                    <h2>Recent products</h2>
                </div>
                <a class="btn btn-secondary btn-sm" asp-action="Products">Manage all</a>
            </div>

            <div class="admin-product-list">
                @foreach (var product in Model.RecentProducts)
                {
                    <div class="admin-product-row">
                        <div class="admin-product-thumb">
                            @if (!string.IsNullOrWhiteSpace(product.ImagePath))
                            {
                                <img src="@product.ImagePath" alt="@product.Name" />
                            }
                            else
                            {
                                <span>IMG</span>
                            }
                        </div>
                        <div class="admin-product-info">
                            <strong>@product.Name</strong>
                            <span>@product.Manufacturer · @product.BusinessType?.Name</span>
                        </div>
                        <div class="admin-product-price">Rs. @product.Price.ToString("N0")</div>
                        <span class="pill @(product.IsActive ? "pill-new" : "pill-fair")">@(product.IsActive ? "Active" : "Inactive")</span>
                        <a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                    </div>
                }
            </div>
        </div>
    </section>
</div>
