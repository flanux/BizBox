@model List<Bizbox.Models.Product>
@{
    ViewData["Title"] = "Manage Products";
}

<div class="admin-shell">
    <partial name="_Sidebar" />

    <section class="admin-main">
        <div class="page-header">
            <span class="eyebrow">Catalog</span>
            <div class="admin-header-row">
                <div>
                    <h1>Products</h1>
                    <p>Edit pricing, descriptions, specifications, images, visibility, and relationships.</p>
                </div>
                <a class="btn" asp-controller="Admin" asp-action="Create">+ Add Product</a>
            </div>
        </div>

        @if (TempData["AdminMessage"] is string message)
        {
            <div class="admin-alert">@message</div>
        }

        @if (!Model.Any())
        {
            <div class="empty-state"><span class="icon">📦</span><p>No products yet. Add your first product to get started.</p></div>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Manufacturer</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>
                                    <div class="admin-table-product">
                                        <div class="admin-product-thumb small">
                                            @if (!string.IsNullOrWhiteSpace(p.ImagePath))
                                            {
                                                <img src="@p.ImagePath" alt="@p.Name" />
                                            }
                                            else
                                            {
                                                <span>IMG</span>
                                            }
                                        </div>
                                        <div><strong>@p.Name</strong><small>@p.Specs</small></div>
                                    </div>
                                </td>
                                <td>@p.BusinessType?.Name</td>
                                <td>@(p.Manufacturer ?? "—")</td>
                                <td>Rs. @p.Price.ToString("N0")</td>
                                <td><span class="pill @(p.IsActive ? "pill-new" : "pill-fair")">@(p.IsActive ? "Active" : "Inactive")</span></td>
                                <td>
                                    <div class="admin-actions">
                                        <a class="btn btn-secondary btn-sm" asp-controller="Admin" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                                        <form method="post" asp-controller="Admin" asp-action="ToggleActive" asp-route-id="@p.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-secondary btn-sm">@(p.IsActive ? "Disable" : "Enable")</button>
                                        </form>
                                        <form method="post" asp-controller="Admin" asp-action="DeleteProduct" asp-route-id="@p.Id" onsubmit="return confirm('Delete this product? This can\'t be undone.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-secondary btn-sm">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
