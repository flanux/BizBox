@{
    ViewData["Title"] = "Admin — Add Product";
}
<h1>Add a Product</h1>

<form method="post" asp-action="Create" asp-controller="Admin">
    <label>Name<br /><input type="text" name="name" required /></label><br />
    <label>Description<br /><textarea name="description"></textarea></label><br />
    <label>Price (Rs.)<br /><input type="number" name="price" step="0.01" required /></label><br />

    <label>Business type<br />
        <select name="businessTypeId">
            @foreach (var bt in (List<BusinessType>)ViewBag.BusinessTypes)
            {
                <option value="@bt.Id">@bt.Name</option>
            }
        </select>
    </label><br />

    <label>Supersedes (optional — marks this as a newer model replacing an older one)<br />
        <select name="supersedesProductId">
            <option value="">-- none --</option>
            @foreach (var p in (List<Product>)ViewBag.ExistingProducts)
            {
                <option value="@p.Id">@p.Name</option>
            }
        </select>
    </label><br /><br />

    <button type="submit">Add Product</button>
</form>
