@model BusinessType
@{
    ViewData["Title"] = Model.Name + " Catalog";
}

<h1>@Model.Name &mdash; Starter Kit</h1>
<p>@Model.ShortDescription</p>

<div class="product-grid">
    @foreach (var product in Model.Products)
    {
        <div class="product-card">
            <h3>@product.Name</h3>
            <p>@product.Description</p>
            <p class="price">Rs. @product.Price.ToString("N0")</p>

            @if (product.SupersedesProductId != null)
            {
                <p class="upgrade-note">Newer model &mdash; replaces an earlier version</p>
            }

            <form method="post" asp-action="AddToCart" asp-controller="BusinessType">
                <input type="hidden" name="productId" value="@product.Id" />
                <input type="hidden" name="businessTypeId" value="@Model.Id" />
                <button type="submit">Add to Cart</button>
            </form>
        </div>
    }
</div>
